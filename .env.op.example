# Secret references for local development — a template, not a secret.
#
# Copy this file to `.env.op` (git-ignored) and replace each placeholder with
# the reference to your own 1Password item: in the 1Password app, open the
# item, choose the field's menu, then "Copy Secret Reference".
# Then run: npm run dev:op
#
# `.env.op` holds only references such as op://Private/Issuebridge dev/exchange url.
# The values are read from 1Password when the command starts and are never
# written to disk. See README.md, "Secrets from 1Password".

# The OAuth exchange backend — the same value Release builds are given.
ISSUEBRIDGE_OAUTH_EXCHANGE_URL="op://<vault>/<item>/<field>"

# Local/dev only, instead of the exchange URL. Never baked into a Release.
# ISSUEBRIDGE_GITHUB_CLIENT_SECRET="op://<vault>/<item>/<field>"
